{
    "manifest_version": 3,
    "name": "__MSG_appName__",
    "description": "__MSG_appDescription__",
    "version": "2.0.1",
    "default_locale": "en",

    "author": "Sanjay Choudhary",

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "host_permissions": [
        "https://gemini.google.com/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}